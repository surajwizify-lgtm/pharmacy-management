// ============================================================================
// PHARMACY MANAGEMENT SYSTEM — PRISMA SCHEMA
// Mirrors pharmacy_schema.sql exactly via @@map / @map, so this works
// against a database created from that SQL file without renaming anything.
// ============================================================================

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
    admin
    pharmacist
    cashier
    accountant
}

enum ActiveStatus {
    active
    inactive
}

enum VendorType {
    distributor
    supplier
    both
}

enum ProductStatus {
    active
    inactive
    discontinued
}

enum ScheduleType {
    OTC
    H
    H1
    X
}

enum AdjustmentReason {
    damaged
    expired_writeoff
    theft
    stock_count_correction
    other
}

enum POStatus {
    draft
    sent
    partially_received
    received
    cancelled
}

enum PaymentStatus {
    paid
    partial
    due
}

enum PurchasePaymentMode {
    cash
    bank
    upi
    cheque
    credit
}

enum PurchaseReturnReason {
    expired
    damaged
    wrong_item
    excess_supply
    other
}

enum RefundType {
    cash_refund
    credit_note
    adjust_next_bill
}

enum VendorPaymentMode {
    cash
    bank
    upi
    cheque
}

enum BillPaymentMode {
    cash
    card
    upi
    credit
    split
}

enum BillStatus {
    completed
    held
    cancelled
}

enum SalesReturnReason {
    wrong_product
    customer_refusal
    expired_at_sale
    other
}

enum SalesRefundMode {
    cash
    adjust_next_bill
    credit_note
}

enum CustomerPaymentMode {
    cash
    card
    upi
    bank
}

enum GstPeriodStatus {
    pending
    filed
}

enum NotificationType {
    low_stock
    expiry
    payment_due
}

enum AuditAction {
    create
    update
    delete
    cancel
}

// ============================================================================
// 1. USERS
// ============================================================================

model User {
    id           Int          @id @default(autoincrement())
    name         String       @db.VarChar(150)
    phone        String?      @db.VarChar(20)
    email        String?      @unique @db.VarChar(150)
    username     String       @unique @db.VarChar(100)
    passwordHash String       @map("password_hash") @db.VarChar(255)
    role         UserRole     @default(cashier)
    status       ActiveStatus @default(active)
    lastLoginAt  DateTime?    @map("last_login_at")
    createdAt    DateTime     @default(now()) @map("created_at")
    updatedAt    DateTime     @updatedAt @map("updated_at")

    purchaseOrdersCreated    PurchaseOrder[]   @relation("POCreatedBy")
    purchaseInvoicesCreated  PurchaseInvoice[] @relation("InvoiceCreatedBy")
    purchaseReturnsCreated   PurchaseReturn[]  @relation("PurchaseReturnCreatedBy")
    vendorPaymentsCreated    VendorPayment[]   @relation("VendorPaymentCreatedBy")
    stockAdjustmentsApproved StockAdjustment[] @relation("AdjustmentApprovedBy")
    billsAsBiller            Bill[]            @relation("BillBiller")
    salesReturnsCreated      SalesReturn[]     @relation("SalesReturnCreatedBy")
    customerPaymentsCreated  CustomerPayment[] @relation("CustomerPaymentCreatedBy")
    gstPeriodsFiled          GstPeriod[]       @relation("GstPeriodFiledBy")
    auditLogs                AuditLog[]

    @@map("users")
}

// ============================================================================
// 2. MASTERS
// ============================================================================

model Manufacturer {
    id            Int          @id @default(autoincrement())
    name          String       @db.VarChar(150)
    contactPerson String?      @map("contact_person") @db.VarChar(150)
    phone         String?      @db.VarChar(20)
    email         String?      @db.VarChar(150)
    address       String?      @db.Text
    gstin         String?      @db.VarChar(20)
    drugLicenseNo String?      @map("drug_license_no") @db.VarChar(50)
    status        ActiveStatus @default(active)
    createdAt     DateTime     @default(now()) @map("created_at")
    updatedAt     DateTime     @updatedAt @map("updated_at")

    products            Product[]
    vendorManufacturers VendorManufacturer[]

    @@map("manufacturers")
}

model Vendor {
    id             Int          @id @default(autoincrement())
    name           String       @db.VarChar(150)
    type           VendorType   @default(both)
    contactPerson  String?      @map("contact_person") @db.VarChar(150)
    phone          String?      @db.VarChar(20)
    email          String?      @db.VarChar(150)
    address        String?      @db.Text
    gstin          String?      @db.VarChar(20)
    drugLicenseNo  String?      @map("drug_license_no") @db.VarChar(50)
    paymentTerms   String?      @map("payment_terms") @db.VarChar(100)
    bankDetails    String?      @map("bank_details") @db.Text
    openingBalance Decimal      @default(0.00) @map("opening_balance") @db.Decimal(12, 2)
    currentBalance Decimal      @default(0.00) @map("current_balance") @db.Decimal(12, 2)
    status         ActiveStatus @default(active)
    createdAt      DateTime     @default(now()) @map("created_at")
    updatedAt      DateTime     @updatedAt @map("updated_at")

    vendorManufacturers VendorManufacturer[]
    purchaseOrders      PurchaseOrder[]
    purchaseInvoices    PurchaseInvoice[]
    purchaseReturns     PurchaseReturn[]
    vendorPayments      VendorPayment[]

    @@map("vendors")
}

model VendorManufacturer {
    vendorId       Int @map("vendor_id")
    manufacturerId Int @map("manufacturer_id")

    vendor       Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
    manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

    @@id([vendorId, manufacturerId])
    @@map("vendor_manufacturers")
}

model Category {
    id                Int      @id @default(autoincrement())
    name              String   @unique @db.VarChar(100)
    parentId          Int?     @map("parent_id")
    // Defines which extra fields products in this category should show in the
    // Add/Edit Product form, e.g.:
    // [{"key":"strength","label":"Strength","type":"text"},
    //  {"key":"composition","label":"Composition","type":"text"}]
    // for Tablets/Syrups, vs
    // [{"key":"size","label":"Size","type":"text"},
    //  {"key":"material","label":"Material","type":"text"}]
    // for Surgical. Read by the frontend to render dynamic fields; the actual
    // values per product are stored in Product.attributes below.
    attributeTemplate Json?    @map("attribute_template")
    createdAt         DateTime @default(now()) @map("created_at")

    parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
    children Category[] @relation("CategoryParent")
    products Product[]

    @@map("categories")
}

model Product {
    id             Int           @id @default(autoincrement())
    name           String        @db.VarChar(200)
    genericName    String?       @map("generic_name") @db.VarChar(200)
    categoryId     Int?          @map("category_id")
    manufacturerId Int?          @map("manufacturer_id")
    unit           String        @default("strip") @db.VarChar(30)
    packSize       String?       @map("pack_size") @db.VarChar(30)
    hsnCode        String?       @map("hsn_code") @db.VarChar(20)
    gstPercent     Decimal       @default(0.00) @map("gst_percent") @db.Decimal(5, 2)
    defaultMrp     Decimal       @default(0.00) @map("default_mrp") @db.Decimal(10, 2)
    reorderLevel   Int           @default(10) @map("reorder_level")
    rackLocation   String?       @map("rack_location") @db.VarChar(50)
    scheduleType   ScheduleType  @default(OTC) @map("schedule_type")
    // Whether Purchase/Billing screens should ask for batch no. + expiry for
    // this product. True for nearly everything (products, cosmetics); set
    // false only for non-expiring items like equipment/devices.
    tracksExpiry   Boolean       @default(true) @map("tracks_expiry")
    // Type-specific values matching the owning category's attributeTemplate,
    // e.g. {"strength":"500mg","composition":"Paracetamol"} for a tablet,
    // or {"size":"Medium","material":"Latex"} for a surgical glove.
    attributes     Json?
    status         ProductStatus @default(active)
    createdAt      DateTime      @default(now()) @map("created_at")
    updatedAt      DateTime      @updatedAt @map("updated_at")

    category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
    manufacturer         Manufacturer?         @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
    batchStock           BatchStock[]
    purchaseOrderItems   PurchaseOrderItem[]
    purchaseInvoiceItems PurchaseInvoiceItem[]
    purchaseReturnItems  PurchaseReturnItem[]
    billItems            BillItem[]
    salesReturnItems     SalesReturnItem[]
    stockAdjustments     StockAdjustment[]

    @@index([name])
    @@map("products")
}

// ============================================================================
// 3. INVENTORY
// ============================================================================

model BatchStock {
    id              Int      @id @default(autoincrement())
    productId       Int      @map("product_id")
    batchNo         String   @map("batch_no") @db.VarChar(50)
    expiryDate      DateTime @map("expiry_date") @db.Date
    purchaseRate    Decimal  @map("purchase_rate") @db.Decimal(10, 2)
    mrp             Decimal  @db.Decimal(10, 2)
    currentQuantity Int      @default(0) @map("current_quantity")
    rackLocation    String?  @map("rack_location") @db.VarChar(50)
    createdAt       DateTime @default(now()) @map("created_at")
    updatedAt       DateTime @updatedAt @map("updated_at")

    product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
    billItems        BillItem[]
    salesReturnItems SalesReturnItem[]
    stockAdjustments StockAdjustment[]

    @@unique([productId, batchNo, expiryDate], name: "uq_product_batch")
    @@index([expiryDate])
    @@index([productId, currentQuantity])
    @@map("batch_stock")
}

model StockAdjustment {
    id               Int              @id @default(autoincrement())
    productId        Int              @map("product_id")
    batchStockId     Int              @map("batch_stock_id")
    quantityAdjusted Int              @map("quantity_adjusted")
    reason           AdjustmentReason
    notes            String?          @db.VarChar(255)
    approvedBy       Int              @map("approved_by")
    adjustmentDate   DateTime         @map("adjustment_date") @db.Date
    createdAt        DateTime         @default(now()) @map("created_at")

    product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
    batchStock BatchStock @relation(fields: [batchStockId], references: [id], onDelete: Restrict)
    approver   User       @relation("AdjustmentApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)

    @@map("stock_adjustments")
}

// ============================================================================
// 4. PURCHASE MODULE
// ============================================================================

model PurchaseOrder {
    id                   Int       @id @default(autoincrement())
    poNumber             String    @unique @map("po_number") @db.VarChar(50)
    vendorId             Int       @map("vendor_id")
    orderDate            DateTime  @map("order_date") @db.Date
    expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
    status               POStatus  @default(draft)
    createdBy            Int       @map("created_by")
    createdAt            DateTime  @default(now()) @map("created_at")
    updatedAt            DateTime  @updatedAt @map("updated_at")

    vendor           Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
    creator          User                @relation("POCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
    items            PurchaseOrderItem[]
    purchaseInvoices PurchaseInvoice[]

    @@map("purchase_orders")
}

model PurchaseOrderItem {
    id           Int      @id @default(autoincrement())
    poId         Int      @map("po_id")
    productId    Int      @map("product_id")
    quantity     Int
    expectedRate Decimal? @map("expected_rate") @db.Decimal(10, 2)

    purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
    product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

    @@map("purchase_order_items")
}

model PurchaseInvoice {
    id             Int                 @id @default(autoincrement())
    invoiceNumber  String              @map("invoice_number") @db.VarChar(50)
    grnNumber      String              @unique @map("grn_number") @db.VarChar(50)
    vendorId       Int                 @map("vendor_id")
    poId           Int?                @map("po_id")
    invoiceDate    DateTime            @map("invoice_date") @db.Date
    totalAmount    Decimal             @default(0.00) @map("total_amount") @db.Decimal(12, 2)
    paymentStatus  PaymentStatus       @default(due) @map("payment_status")
    paymentMode    PurchasePaymentMode @default(credit) @map("payment_mode")
    amountPaid     Decimal             @default(0.00) @map("amount_paid") @db.Decimal(12, 2)
    balanceDue     Decimal             @default(0.00) @map("balance_due") @db.Decimal(12, 2)
    attachmentPath String?             @map("attachment_path") @db.VarChar(255)
    createdBy      Int                 @map("created_by")
    createdAt      DateTime            @default(now()) @map("created_at")
    updatedAt      DateTime            @updatedAt @map("updated_at")

    vendor          Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
    purchaseOrder   PurchaseOrder?        @relation(fields: [poId], references: [id], onDelete: SetNull)
    creator         User                  @relation("InvoiceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
    items           PurchaseInvoiceItem[]
    purchaseReturns PurchaseReturn[]
    vendorPayments  VendorPayment[]

    @@index([invoiceDate])
    @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
    id                Int       @id @default(autoincrement())
    purchaseInvoiceId Int       @map("purchase_invoice_id")
    productId         Int       @map("product_id")
    batchNo           String    @map("batch_no") @db.VarChar(50)
    mfgDate           DateTime? @map("mfg_date") @db.Date
    expiryDate        DateTime  @map("expiry_date") @db.Date
    quantity          Int
    freeQuantity      Int       @default(0) @map("free_quantity")
    purchaseRate      Decimal   @map("purchase_rate") @db.Decimal(10, 2)
    mrp               Decimal   @db.Decimal(10, 2)
    discountPercent   Decimal   @default(0.00) @map("discount_percent") @db.Decimal(5, 2)
    gstPercent        Decimal   @default(0.00) @map("gst_percent") @db.Decimal(5, 2)
    hsnCode           String?   @map("hsn_code") @db.VarChar(20)
    amount            Decimal   @db.Decimal(12, 2)
    createdAt         DateTime  @default(now()) @map("created_at")

    purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
    product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

    @@index([productId, batchNo])
    @@map("purchase_invoice_items")
}

model PurchaseReturn {
    id                Int                  @id @default(autoincrement())
    returnNumber      String               @unique @map("return_number") @db.VarChar(50)
    purchaseInvoiceId Int                  @map("purchase_invoice_id")
    vendorId          Int                  @map("vendor_id")
    returnDate        DateTime             @map("return_date") @db.Date
    reason            PurchaseReturnReason
    refundType        RefundType           @map("refund_type")
    totalAmount       Decimal              @default(0.00) @map("total_amount") @db.Decimal(12, 2)
    createdBy         Int                  @map("created_by")
    createdAt         DateTime             @default(now()) @map("created_at")

    purchaseInvoice PurchaseInvoice      @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)
    vendor          Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
    creator         User                 @relation("PurchaseReturnCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
    items           PurchaseReturnItem[]

    @@map("purchase_returns")
}

model PurchaseReturnItem {
    id               Int     @id @default(autoincrement())
    purchaseReturnId Int     @map("purchase_return_id")
    productId        Int     @map("product_id")
    batchNo          String  @map("batch_no") @db.VarChar(50)
    quantity         Int
    rate             Decimal @db.Decimal(10, 2)
    gstPercent       Decimal @default(0.00) @map("gst_percent") @db.Decimal(5, 2)
    amount           Decimal @db.Decimal(12, 2)

    purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
    product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

    @@map("purchase_return_items")
}

model VendorPayment {
    id                Int               @id @default(autoincrement())
    vendorId          Int               @map("vendor_id")
    purchaseInvoiceId Int?              @map("purchase_invoice_id")
    amount            Decimal           @db.Decimal(12, 2)
    paymentDate       DateTime          @map("payment_date") @db.Date
    mode              VendorPaymentMode
    referenceNo       String?           @map("reference_no") @db.VarChar(100)
    createdBy         Int               @map("created_by")
    createdAt         DateTime          @default(now()) @map("created_at")

    vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
    purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
    creator         User             @relation("VendorPaymentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

    @@map("vendor_payments")
}

// ============================================================================
// 5. SALES MODULE
// ============================================================================

model Customer {
    id             Int          @id @default(autoincrement())
    name           String       @db.VarChar(150)
    phone          String?      @db.VarChar(20)
    address        String?      @db.Text
    dob            DateTime?    @db.Date
    gstin          String?      @db.VarChar(20)
    creditLimit    Decimal      @default(0.00) @map("credit_limit") @db.Decimal(12, 2)
    currentBalance Decimal      @default(0.00) @map("current_balance") @db.Decimal(12, 2)
    status         ActiveStatus @default(active)
    createdAt      DateTime     @default(now()) @map("created_at")
    updatedAt      DateTime     @updatedAt @map("updated_at")

    bills            Bill[]
    customerPayments CustomerPayment[]

    @@index([phone])
    @@map("customers")
}

model Doctor {
    id             Int      @id @default(autoincrement())
    name           String   @db.VarChar(150)
    clinicName     String?  @map("clinic_name") @db.VarChar(150)
    specialization String?  @db.VarChar(100)
    phone          String?  @db.VarChar(20)
    createdAt      DateTime @default(now()) @map("created_at")

    bills Bill[]

    @@map("doctors")
}

model Bill {
    id               Int             @id @default(autoincrement())
    billNumber       String          @unique @map("bill_number") @db.VarChar(50)
    billDate         DateTime        @default(now()) @map("bill_date")
    customerId       Int?            @map("customer_id")
    doctorId         Int?            @map("doctor_id")
    billerId         Int             @map("biller_id")
    subtotal         Decimal         @default(0.00) @db.Decimal(12, 2)
    discountAmount   Decimal         @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
    cgstAmount       Decimal         @default(0.00) @map("cgst_amount") @db.Decimal(12, 2)
    sgstAmount       Decimal         @default(0.00) @map("sgst_amount") @db.Decimal(12, 2)
    igstAmount       Decimal         @default(0.00) @map("igst_amount") @db.Decimal(12, 2)
    roundOff         Decimal         @default(0.00) @map("round_off") @db.Decimal(6, 2)
    grandTotal       Decimal         @default(0.00) @map("grand_total") @db.Decimal(12, 2)
    paymentMode      BillPaymentMode @default(cash) @map("payment_mode")
    paymentStatus    PaymentStatus   @default(paid) @map("payment_status")
    amountPaid       Decimal         @default(0.00) @map("amount_paid") @db.Decimal(12, 2)
    balanceDue       Decimal         @default(0.00) @map("balance_due") @db.Decimal(12, 2)
    prescriptionPath String?         @map("prescription_path") @db.VarChar(255)
    status           BillStatus      @default(completed)
    createdAt        DateTime        @default(now()) @map("created_at")
    updatedAt        DateTime        @updatedAt @map("updated_at")

    customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
    doctor           Doctor?           @relation(fields: [doctorId], references: [id], onDelete: SetNull)
    biller           User              @relation("BillBiller", fields: [billerId], references: [id], onDelete: Restrict)
    items            BillItem[]
    salesReturns     SalesReturn[]
    customerPayments CustomerPayment[]

    @@index([billDate])
    @@index([status, paymentStatus])
    @@map("bills")
}

model BillItem {
    id              Int     @id @default(autoincrement())
    billId          Int     @map("bill_id")
    productId       Int     @map("product_id")
    batchStockId    Int     @map("batch_stock_id")
    quantity        Int
    rate            Decimal @db.Decimal(10, 2)
    discountPercent Decimal @default(0.00) @map("discount_percent") @db.Decimal(5, 2)
    gstPercent      Decimal @default(0.00) @map("gst_percent") @db.Decimal(5, 2)
    cgstAmount      Decimal @default(0.00) @map("cgst_amount") @db.Decimal(10, 2)
    sgstAmount      Decimal @default(0.00) @map("sgst_amount") @db.Decimal(10, 2)
    igstAmount      Decimal @default(0.00) @map("igst_amount") @db.Decimal(10, 2)
    lineTotal       Decimal @map("line_total") @db.Decimal(12, 2)

    bill       Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
    product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
    batchStock BatchStock @relation(fields: [batchStockId], references: [id], onDelete: Restrict)

    @@map("bill_items")
}

model SalesReturn {
    id           Int               @id @default(autoincrement())
    returnNumber String            @unique @map("return_number") @db.VarChar(50)
    billId       Int               @map("bill_id")
    returnDate   DateTime          @map("return_date") @db.Date
    reason       SalesReturnReason
    refundMode   SalesRefundMode   @map("refund_mode")
    totalAmount  Decimal           @default(0.00) @map("total_amount") @db.Decimal(12, 2)
    createdBy    Int               @map("created_by")
    createdAt    DateTime          @default(now()) @map("created_at")

    bill    Bill              @relation(fields: [billId], references: [id], onDelete: Restrict)
    creator User              @relation("SalesReturnCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
    items   SalesReturnItem[]

    @@map("sales_returns")
}

model SalesReturnItem {
    id            Int     @id @default(autoincrement())
    salesReturnId Int     @map("sales_return_id")
    productId     Int     @map("product_id")
    batchStockId  Int     @map("batch_stock_id")
    quantity      Int
    rate          Decimal @db.Decimal(10, 2)
    gstPercent    Decimal @default(0.00) @map("gst_percent") @db.Decimal(5, 2)
    amount        Decimal @db.Decimal(12, 2)

    salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
    product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
    batchStock  BatchStock  @relation(fields: [batchStockId], references: [id], onDelete: Restrict)

    @@map("sales_return_items")
}

model CustomerPayment {
    id          Int                 @id @default(autoincrement())
    customerId  Int                 @map("customer_id")
    billId      Int?                @map("bill_id")
    amount      Decimal             @db.Decimal(12, 2)
    paymentDate DateTime            @map("payment_date") @db.Date
    mode        CustomerPaymentMode
    referenceNo String?             @map("reference_no") @db.VarChar(100)
    createdBy   Int                 @map("created_by")
    createdAt   DateTime            @default(now()) @map("created_at")

    customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
    bill     Bill?    @relation(fields: [billId], references: [id], onDelete: SetNull)
    creator  User     @relation("CustomerPaymentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

    @@map("customer_payments")
}

model GstPeriod {
    id          Int             @id @default(autoincrement())
    periodStart DateTime        @map("period_start") @db.Date
    periodEnd   DateTime        @map("period_end") @db.Date
    amountPaid  Decimal         @default(0.00) @map("amount_paid") @db.Decimal(12, 2)
    status      GstPeriodStatus @default(pending)
    filedDate   DateTime?       @map("filed_date") @db.Date
    filedBy     Int?            @map("filed_by")
    createdAt   DateTime        @default(now()) @map("created_at")

    filer User? @relation("GstPeriodFiledBy", fields: [filedBy], references: [id], onDelete: SetNull)

    @@unique([periodStart, periodEnd], name: "uq_period")
    @@map("gst_periods")
}

// ============================================================================
// 7. SYSTEM
// ============================================================================

model Notification {
    id             Int              @id @default(autoincrement())
    type           NotificationType
    referenceTable String           @map("reference_table") @db.VarChar(50)
    referenceId    Int              @map("reference_id")
    message        String           @db.VarChar(255)
    isRead         Boolean          @default(false) @map("is_read")
    createdAt      DateTime         @default(now()) @map("created_at")

    @@index([isRead])
    @@map("notifications")
}

model AuditLog {
    id        BigInt      @id @default(autoincrement())
    userId    Int         @map("user_id")
    action    AuditAction
    tableName String      @map("table_name") @db.VarChar(50)
    recordId  Int         @map("record_id")
    oldValue  Json?       @map("old_value")
    newValue  Json?       @map("new_value")
    createdAt DateTime    @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Restrict)

    @@index([tableName, recordId])
    @@map("audit_log")
}

model Setting {
    key       String   @id @db.VarChar(100)
    value     String?  @db.Text
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("settings")
}
