generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PHARMACIST
  CASHIER
  ACCOUNTANT
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name") @db.VarChar(200)
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  bills            Bill[]
  auditLogs        AuditLog[]
  stockAdjustments StockAdjustment[]

  @@map("users")
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String     @unique @db.VarChar(100)
  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")

  products Product[]

  @@map("categories")
}

model Manufacturer {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(200)
  contactPerson String?        @map("contact_person") @db.VarChar(200)
  phone         String?        @db.VarChar(20)
  email         String?        @db.VarChar(150)
  address       String?        @db.VarChar(300)
  gstin         String?        @db.VarChar(15)
  drugLicenseNo String?        @map("drug_license_no") @db.VarChar(50)
  status        SupplierStatus @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  products  Product[]
  suppliers SupplierManufacturer[]

  @@index([name])
  @@map("manufacturers")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum LocationType {
  RACK
  SHELF
  BIN
  COLD_STORAGE
  WAREHOUSE
  OTHER
}

model Location {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(100) // e.g. "Rack A1", "Shelf 3-B"
  code        String?      @unique @db.VarChar(20) // short scannable code, e.g. "A1-03"
  type        LocationType @default(RACK)
  description String?      @db.VarChar(300)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  batches Batch[]

  @@index([name])
  @@index([code])
  @@map("locations")
}

model Supplier {
  id            Int     @id @default(autoincrement())
  name          String
  contactPerson String?
  email         String? @unique
  phone         String?
  address       String?
  gstin         String?
  drugLicenseNo String? @map("drug_license_no")
  paymentTerms  String? @map("payment_terms")

  bankDetails String? @map("bank_details")

  openingBalance Decimal @default(0) @map("opening_balance") @db.Decimal(12, 2)
  currentBalance Decimal @default(0) @map("current_balance") @db.Decimal(12, 2)

  status    SupplierStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  manufacturers SupplierManufacturer[]

  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  payments         SupplierPayment[]
  supplierReturns  SupplierReturn[]

  @@map("suppliers")
}

model SupplierManufacturer {
  supplierId     Int
  manufacturerId Int

  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@id([supplierId, manufacturerId])
  @@map("supplier_manufacturers")
}

enum ProductStatus {
  ACTIVE
  DISCONTINUED
}

enum GstType {
  INCLUSIVE
  EXCLUSIVE
}

enum ScheduleType {
  OTC
  SCHEDULE_H
  SCHEDULE_H1
  SCHEDULE_X
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(200)
  genericName String? @map("generic_name") @db.VarChar(200)

  manufacturer    String?       @db.VarChar(200) // free-text fallback, kept for backward compatibility
  manufacturerId  Int?          @map("manufacturer_id")
  manufacturerRef Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)

  categoryId Int?      @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  barcode String? @db.VarChar(50)
  hsnCode String? @map("hsn_code") @db.VarChar(20) // not unique: multiple products may legitimately share an HSN code

  gstPercentage Decimal @default(0.00) @map("gst_percentage") @db.Decimal(5, 2)
  mrp           Decimal @default(0.00) @map("mrp") @db.Decimal(10, 2)
  cp            Decimal @default(0.00) @map("cp") @db.Decimal(10, 2)
  sp            Decimal @default(0.00) @map("sp") @db.Decimal(10, 2)
  gstType       GstType @default(INCLUSIVE) @map("gst_type")

  unit         String  @default("strip") @db.VarChar(50) // Strip/Bottle/Box/Piece
  packSize     String? @map("pack_size") @db.VarChar(50)
  defaultMrp   Decimal @default(0.00) @map("default_mrp") @db.Decimal(10, 2)
  reorderLevel Int     @default(10) @map("reorder_level")
  rackLocation String? @map("rack_location") @db.VarChar(50)

  scheduleType         ScheduleType @default(OTC) @map("schedule_type")
  prescriptionRequired Boolean      @default(false) @map("prescription_required")
  tracksExpiry         Boolean      @default(true) @map("tracks_expiry")
  attributes           Json?

  status    ProductStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  version   Int           @default(0)

  batches              Batch[]
  billItems            BillItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  supplierReturnItems  SupplierReturnItem[]
  stockAdjustments     StockAdjustment[]

  @@index([name])
  @@index([hsnCode])
  @@index([status])
  @@index([barcode])
  @@map("products")
}

model Batch {
  id                Int       @id @default(autoincrement())
  productId         Int       @map("product_id")
  product           Product   @relation(fields: [productId], references: [id])
  batchNumber       String    @map("batch_number") @db.VarChar(50)
  manufactureDate   DateTime? @map("manufacture_date") @db.Date
  expiryDate        DateTime  @map("expiry_date") @db.Date
  purchasePrice     Decimal   @map("purchase_price") @db.Decimal(10, 2)
  mrp               Decimal   @default(0) @map("mrp") @db.Decimal(10, 2)
  sellingPrice      Decimal   @map("selling_price") @db.Decimal(10, 2)
  quantityAvailable Int       @map("quantity_available")
  locationId        Int?      @map("location_id")
  location          Location? @relation(fields: [locationId], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  version           Int       @default(0)

  billItems           BillItem[]
  returnItems         ReturnItem[]
  purchaseInvoiceItem PurchaseInvoiceItem?
  supplierReturnItems SupplierReturnItem[]
  stockAdjustments    StockAdjustment[]

  @@index([productId])
  @@index([expiryDate])
  @@index([batchNumber])
  @@index([locationId])
  @@index([productId, expiryDate])
  @@map("batches")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// Step 1: a request sent to the supplier. Creates NO stock movement.
model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  poNumber     String              @unique @map("po_number")
  supplierId   Int                 @map("supplier_id")
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now()) @map("order_date")
  expectedDate DateTime?           @map("expected_date")
  notes        String?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  items            PurchaseOrderItem[]
  purchaseInvoices PurchaseInvoice[] // one PO can be received across multiple GRNs (partial delivery)

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int           @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId    Int     @map("product_id")
  product      Product @relation(fields: [productId], references: [id])
  quantity     Int
  expectedRate Decimal @map("expected_rate") @db.Decimal(10, 2)

  @@index([productId])
  @@map("purchase_order_items")
}

enum PaymentStatusPO {
  DUE
  PARTIAL
  PAID
}

model PurchaseInvoice {
  id              Int            @id @default(autoincrement())
  invoiceNumber   String         @map("invoice_number") @db.VarChar(100) // supplier's own invoice number
  grnNumber       String         @unique @map("grn_number") // internal auto number
  supplierId      Int            @map("supplier_id")
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrderId Int?           @map("purchase_order_id")
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  invoiceDate  DateTime @default(now()) @map("invoice_date")
  isInterState Boolean  @default(false) @map("is_inter_state") // IGST vs CGST+SGST

  subtotal      Decimal @db.Decimal(12, 2)
  totalDiscount Decimal @default(0) @map("total_discount") @db.Decimal(12, 2)
  totalCgst     Decimal @default(0) @map("total_cgst") @db.Decimal(12, 2)
  totalSgst     Decimal @default(0) @map("total_sgst") @db.Decimal(12, 2)
  totalIgst     Decimal @default(0) @map("total_igst") @db.Decimal(12, 2)
  totalGst      Decimal @map("total_gst") @db.Decimal(12, 2)
  totalAmount   Decimal @map("total_amount") @db.Decimal(12, 2)

  paymentStatus PaymentStatusPO @default(DUE) @map("payment_status")
  attachmentUrl String?         @map("attachment_url") @db.VarChar(500) // scanned invoice upload

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items           PurchaseInvoiceItem[]
  payments        SupplierPayment[]
  supplierReturns SupplierReturn[]
  gstLedgerEntry  GstLedgerEntry?

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([invoiceDate])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                Int             @id @default(autoincrement())
  purchaseInvoiceId Int             @map("purchase_invoice_id")
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  batchNumber     String    @map("batch_number")
  manufactureDate DateTime? @map("manufacture_date") @db.Date
  expiryDate      DateTime  @map("expiry_date") @db.Date

  quantity        Int
  freeQuantity    Int     @default(0) @map("free_quantity") // scheme/free units
  purchaseRate    Decimal @map("purchase_rate") @db.Decimal(10, 2)
  mrp             Decimal @db.Decimal(10, 2)
  sellingPrice    Decimal @map("selling_price") @db.Decimal(10, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)

  hsnCode       String  @map("hsn_code") @db.VarChar(20)
  gstPercentage Decimal @map("gst_percentage") @db.Decimal(5, 2)
  cgstAmount    Decimal @default(0) @map("cgst_amount") @db.Decimal(10, 2)
  sgstAmount    Decimal @default(0) @map("sgst_amount") @db.Decimal(10, 2)
  igstAmount    Decimal @default(0) @map("igst_amount") @db.Decimal(10, 2)

  taxableValue Decimal @map("taxable_value") @db.Decimal(12, 2) // qty * rate - discount
  totalAmount  Decimal @map("total_amount") @db.Decimal(12, 2) // taxable + gst

  location String?

  batchId Int?   @unique @map("batch_id")
  batch   Batch? @relation(fields: [batchId], references: [id])

  @@index([productId])
  @@map("purchase_invoice_items")
}

model SupplierReturn {
  id                Int              @id @default(autoincrement())
  returnNumber      String           @unique @map("return_number")
  supplierId        Int              @map("supplier_id")
  supplier          Supplier         @relation(fields: [supplierId], references: [id])
  purchaseInvoiceId Int?             @map("purchase_invoice_id")
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  reason      String? // Expired / Damaged / Wrong item / Excess supply
  refundType  String  @default("credit_note") @map("refund_type") // cash_refund / credit_note / adjust_next_bill
  totalAmount Decimal @map("total_amount") @db.Decimal(12, 2)
  totalGst    Decimal @default(0) @map("total_gst") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  items          SupplierReturnItem[]
  gstLedgerEntry GstLedgerEntry?

  @@index([supplierId])
  @@index([purchaseInvoiceId])
  @@map("supplier_returns")
}

model SupplierReturnItem {
  id               Int            @id @default(autoincrement())
  supplierReturnId Int            @map("supplier_return_id")
  supplierReturn   SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)

  batchId   Int     @map("batch_id")
  batch     Batch   @relation(fields: [batchId], references: [id])
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(10, 2)
  gstAmount  Decimal @default(0) @map("gst_amount") @db.Decimal(10, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)

  @@index([batchId])
  @@map("supplier_return_items")
}

model SupplierPayment {
  id                Int              @id @default(autoincrement())
  supplierId        Int              @map("supplier_id")
  supplier          Supplier         @relation(fields: [supplierId], references: [id])
  purchaseInvoiceId Int?             @map("purchase_invoice_id")
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  amount      Decimal  @db.Decimal(12, 2)
  paymentMode String   @map("payment_mode") // cash, bank_transfer, cheque, upi
  referenceNo String?  @map("reference_no")
  paidAt      DateTime @default(now()) @map("paid_at")
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([supplierId])
  @@index([purchaseInvoiceId])
  @@map("supplier_payments")
}

enum AdjustmentReason {
  DAMAGED
  EXPIRED_WRITE_OFF
  THEFT
  STOCK_COUNT_CORRECTION
  OTHER
}

model StockAdjustment {
  id               Int              @id @default(autoincrement())
  adjustmentNumber String           @unique @map("adjustment_number")
  productId        Int              @map("product_id")
  product          Product          @relation(fields: [productId], references: [id])
  batchId          Int              @map("batch_id")
  batch            Batch            @relation(fields: [batchId], references: [id])
  quantityAdjusted Int              @map("quantity_adjusted") // +/-
  reason           AdjustmentReason
  notes            String?
  approvedById     Int?             @map("approved_by_id")
  approvedBy       User?            @relation(fields: [approvedById], references: [id])
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([productId])
  @@index([batchId])
  @@map("stock_adjustments")
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  OTHER
}

model Doctor {
  id             Int     @id @default(autoincrement())
  name           String  @db.VarChar(200)
  registrationNo String? @unique @map("registration_no") @db.VarChar(50)
  specialization String? @db.VarChar(100)
  phone          String? @db.VarChar(20)

  bills Bill[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("doctors")
}

model Hospital {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(200)
  address String? @db.VarChar(300)
  phone   String? @db.VarChar(20)
  gstin   String? @unique @db.VarChar(15)

  bills Bill[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("hospitals")
}

model Customer {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(200)
  phone   String? @unique @db.VarChar(20)
  email   String? @db.VarChar(150)
  address String? @db.VarChar(300)
  gstin   String? @db.VarChar(15)

  // Optional: track running balance if you ever support customer credit/dues
  openingBalance Decimal @default(0) @map("opening_balance") @db.Decimal(12, 2)
  currentBalance Decimal @default(0) @map("current_balance") @db.Decimal(12, 2)

  active Boolean @default(true)

  bills Bill[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Bill {
  id         Int      @id @default(autoincrement())
  billNumber String   @unique @map("bill_number") @db.VarChar(50)
  billDate   DateTime @default(now()) @map("bill_date")

  cashierId Int  @map("cashier_id")
  cashier   User @relation(fields: [cashierId], references: [id])

  ipOp String? @map("ip_op") @db.VarChar(15)

  doctorId Int?    @map("doctor_id")
  doctor   Doctor? @relation(fields: [doctorId], references: [id])

  hospitalId Int?      @map("hospital_id")
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  customerId Int?      @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id])

  prescriptionFile String? @map("prescription_file") @db.VarChar(500)
  prescriptionName String? @map("prescription_name") @db.VarChar(255)
  prescriptionType String? @map("prescription_type") @db.VarChar(100)

  isInterState Boolean @default(false) @map("is_inter_state")

  subtotal    Decimal @db.Decimal(10, 2)
  totalCgst   Decimal @default(0) @map("total_cgst") @db.Decimal(10, 2)
  totalSgst   Decimal @default(0) @map("total_sgst") @db.Decimal(10, 2)
  totalIgst   Decimal @default(0) @map("total_igst") @db.Decimal(10, 2)
  totalGst    Decimal @map("total_gst") @db.Decimal(10, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(10, 2)

  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")

  cancelled          Boolean @default(false)
  cancellationReason String? @map("cancellation_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  billItems      BillItem[]
  payments       Payment[]
  returns        Return[]
  gstLedgerEntry GstLedgerEntry?

  @@index([billDate])
  @@index([cashierId])
  @@index([doctorId])
  @@index([hospitalId])
  @@index([customerId])
  @@map("bills")
}

model BillItem {
  id            Int     @id @default(autoincrement())
  billId        Int     @map("bill_id")
  bill          Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId     Int     @map("product_id")
  product       Product @relation(fields: [productId], references: [id])
  batchId       Int     @map("batch_id")
  batch         Batch   @relation(fields: [batchId], references: [id])
  batchNumber   String  @map("batch_number") @db.VarChar(50)
  quantity      Int
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  gstPercentage Decimal @map("gst_percentage") @db.Decimal(5, 2)
  cgstAmount    Decimal @default(0) @map("cgst_amount") @db.Decimal(10, 2)
  sgstAmount    Decimal @default(0) @map("sgst_amount") @db.Decimal(10, 2)
  igstAmount    Decimal @default(0) @map("igst_amount") @db.Decimal(10, 2)
  gstAmount     Decimal @map("gst_amount") @db.Decimal(10, 2)
  totalAmount   Decimal @map("total_amount") @db.Decimal(10, 2)

  @@index([billId])
  @@index([batchId])
  @@map("bill_items")
}

model Payment {
  id     Int           @id @default(autoincrement())
  billId Int           @map("bill_id")
  bill   Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount Decimal       @db.Decimal(10, 2)
  method PaymentMethod
  paidAt DateTime      @default(now()) @map("paid_at")

  @@index([billId])
  @@map("payments")
}

model Return {
  id          Int      @id @default(autoincrement())
  billId      Int      @map("bill_id")
  bill        Bill     @relation(fields: [billId], references: [id])
  reason      String?
  totalRefund Decimal  @map("total_refund") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  returnItems    ReturnItem[]
  gstLedgerEntry GstLedgerEntry?

  @@index([billId])
  @@map("returns")
}

model ReturnItem {
  id           Int     @id @default(autoincrement())
  returnId     Int     @map("return_id")
  return       Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  batchId      Int     @map("batch_id")
  batch        Batch   @relation(fields: [batchId], references: [id])
  quantity     Int
  refundAmount Decimal @map("refund_amount") @db.Decimal(10, 2)

  @@index([returnId])
  @@map("return_items")
}

// ========================================================
// GST LEDGER (Section 6 of the spec)
// A ledger, not a data-entry screen — populated automatically
// from Purchase Invoices (input tax) and Bills (output tax).
// ========================================================

enum GstLedgerType {
  INPUT // from purchases
  OUTPUT // from sales
}

model GstFilingPeriod {
  id             Int       @id @default(autoincrement())
  periodStart    DateTime  @map("period_start") @db.Date
  periodEnd      DateTime  @map("period_end") @db.Date
  totalOutputGst Decimal   @map("total_output_gst") @db.Decimal(12, 2)
  totalInputGst  Decimal   @map("total_input_gst") @db.Decimal(12, 2)
  netPayable     Decimal   @map("net_payable") @db.Decimal(12, 2)
  amountPaid     Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  filed          Boolean   @default(false)
  filedAt        DateTime? @map("filed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("gst_filing_periods")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  Int?     @map("entity_id")
  details   String?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model GstLedgerEntry {
  id   Int           @id @default(autoincrement())
  type GstLedgerType

  purchaseInvoiceId Int?             @unique @map("purchase_invoice_id")
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  supplierReturnId Int?            @unique @map("supplier_return_id")
  supplierReturn   SupplierReturn? @relation(fields: [supplierReturnId], references: [id])

  billId Int?  @unique @map("bill_id")
  bill   Bill? @relation(fields: [billId], references: [id])

  returnId   Int?    @unique @map("return_id")
  saleReturn Return? @relation(fields: [returnId], references: [id])

  taxableValue Decimal  @map("taxable_value") @db.Decimal(12, 2)
  cgstAmount   Decimal  @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount   Decimal  @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount   Decimal  @default(0) @map("igst_amount") @db.Decimal(12, 2)
  totalGst     Decimal  @map("total_gst") @db.Decimal(12, 2)
  entryDate    DateTime @default(now()) @map("entry_date")

  @@index([type])
  @@index([entryDate])
  @@map("gst_ledger_entries")
}
