// Pharmacy Management System - Prisma schema
// Ported from MedicPOS (Spring Boot / JPA) domain model.
// Key change from the original: GST is split into CGST + SGST (intra-state)
// or IGST (inter-state) instead of a single flat gstPercentage/gstAmount,
// which is what Indian GST-compliant invoices actually require.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- USERS & AUTH ----------

enum Role {
  ADMIN
  PHARMACIST
  CASHIER
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name") @db.VarChar(200)
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  bills     Bill[]
  auditLogs AuditLog[]

  @@map("users")
}

// ---------- CATALOG & INVENTORY ----------

enum MedicineStatus {
  ACTIVE
  DISCONTINUED
}

model Medicine {
  id                   Int            @id @default(autoincrement())
  name                 String         @db.VarChar(200)
  manufacturer         String         @db.VarChar(200)
  category             String?        @db.VarChar(100)
  barcode              String?        @db.VarChar(50) // GTIN/EAN, not unique per unit
  hsnCode              String         @unique @map("hsn_code") @db.VarChar(20)
  gstPercentage        Decimal        @map("gst_percentage") @db.Decimal(5, 2)
  prescriptionRequired Boolean        @default(false) @map("prescription_required")
  status               MedicineStatus @default(ACTIVE)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  version              Int            @default(0) // optimistic locking

  batches   Batch[]
  billItems BillItem[]

  @@index([name])
  @@index([hsnCode])
  @@index([status])
  @@index([barcode])
  @@map("medicines")
}

model Batch {
  id                Int      @id @default(autoincrement())
  medicineId        Int      @map("medicine_id")
  medicine          Medicine @relation(fields: [medicineId], references: [id])
  batchNumber       String   @map("batch_number") @db.VarChar(50)
  expiryDate        DateTime @map("expiry_date") @db.Date
  purchasePrice     Decimal  @map("purchase_price") @db.Decimal(10, 2)
  sellingPrice      Decimal  @map("selling_price") @db.Decimal(10, 2)
  quantityAvailable Int      @map("quantity_available")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  version           Int      @default(0) // optimistic locking

  billItems   BillItem[]
  returnItems ReturnItem[]

  @@index([medicineId])
  @@index([expiryDate])
  @@index([batchNumber])
  @@index([medicineId, expiryDate])
  @@map("batches")
}

// ---------- BILLING ----------

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  OTHER
}

model Doctor {
  id             Int     @id @default(autoincrement())
  name           String  @db.VarChar(200)
  registrationNo String? @unique @map("registration_no") @db.VarChar(50)
  specialization String? @db.VarChar(100)
  phone          String? @db.VarChar(20)

  bills Bill[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("doctors")
}

model Hospital {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(200)
  address String? @db.VarChar(300)
  phone   String? @db.VarChar(20)
  gstin   String? @unique @db.VarChar(15) // useful if you ever bill the hospital directly / B2B

  bills Bill[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("hospitals")
}

